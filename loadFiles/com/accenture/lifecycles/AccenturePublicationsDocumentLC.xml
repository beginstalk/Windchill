<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE NmLoader SYSTEM "standard12_1.dtd">
<NmLoader>
  <csvLifeCycleTemplateBegin handler="wt.lifecycle.LoadLifeCycle.createLifeCycleTemplate">
